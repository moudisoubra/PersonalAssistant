<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PersonalAssistantUI.NameWindow"
        Title="Phonetic Name"
        Width="400" Height="250"
        Background="#0f0f15"
        TransparencyLevelHint="Mica"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterOwner"
        PointerPressed="Window_PointerPressed">

    <Grid RowDefinitions="Auto,*,Auto,*,Auto" Margin="20,20,20,20">
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="WHAT IS YOUR NAME?" 
                   FontSize="22" 
                   FontWeight="Black" 
                   Foreground="#00FF7F" 
                   HorizontalAlignment="Center" 
                   LetterSpacing="2"
                   Margin="0,0,0,10"/>
                   
        <!-- Actual Name Input Field -->
        <StackPanel Grid.Row="1" Margin="0,10,0,10">
            <TextBlock Text="Actual Spelling:" Foreground="#CCCCCC" Margin="0,0,0,5"/>
            <TextBox x:Name="ActualNameInput"
                     Watermark="e.g. Moudi"
                     Background="#22000000"
                     Foreground="#FFFFFF"
                     BorderBrush="#00FF7F"
                     BorderThickness="1"
                     CornerRadius="10"
                     FontSize="16"
                     Padding="10"/>
        </StackPanel>

        <!-- Phonetic Input Field -->
        <StackPanel Grid.Row="3" Margin="0,10,0,10">
            <TextBlock Text="Phonetic Spelling (For the voice):" Foreground="#CCCCCC" Margin="0,0,0,5"/>
            <TextBox x:Name="PhoneticNameInput"
                     Watermark="e.g. Moo-dee"
                     Background="#22000000"
                     Foreground="#FFFFFF"
                     BorderBrush="#00FF7F"
                     BorderThickness="1"
                     CornerRadius="10"
                     FontSize="16"
                     Padding="10"/>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*" Margin="0,20,0,0">
            <Button Grid.Column="0" 
                    Content="🔊 TEST" 
                    Background="#3300BFFF" 
                    Foreground="#00BFFF"
                    CornerRadius="10"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="TestButton_Click"/>
                    
            <Button Grid.Column="1" 
                    Content="💾 SAVE" 
                    Background="#3300FF7F" 
                    Foreground="#00FF7F"
                    CornerRadius="10"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
