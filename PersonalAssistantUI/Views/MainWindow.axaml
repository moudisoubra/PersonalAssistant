<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PersonalAssistantUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
        Width="400" Height="600"
        x:Class="PersonalAssistantUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Bob"
        Background="#1E1E1E"
        TransparencyLevelHint="Mica"
        ExtendClientAreaToDecorationsHint="True">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20,40,20,20">
        
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="BOB" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   Foreground="#00FF7F" 
                   HorizontalAlignment="Center" 
                   LetterSpacing="2"
                   Margin="0,0,0,20"/>
                   
        <!-- Assistant Output -->
        <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="12" Padding="20">
            <TextBlock Text="{Binding AssistantText}" 
                       TextWrapping="Wrap"
                       FontSize="20"
                       FontWeight="Medium"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <!-- User Output -->
        <Border Grid.Row="2" Background="#3A3A3A" CornerRadius="12" Padding="15" Margin="0,20,0,20">
            <StackPanel>
                <TextBlock Text="You said:" FontSize="12" FontWeight="SemiBold" Foreground="#888888" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding UserText}" 
                           TextWrapping="Wrap"
                           FontSize="16"
                           Foreground="#E0E0E0"/>
            </StackPanel>
        </Border>
        
        <!-- Status -->
        <TextBlock Grid.Row="3" 
                   Text="{Binding StatusText}" 
                   FontSize="14" 
                   FontStyle="Italic"
                   Foreground="#00FF7F" 
                   HorizontalAlignment="Center"/>
                   
    </Grid>
</Window>
